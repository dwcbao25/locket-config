#!name=Locket Gold Full Fix - Server Private của Tuti
#!desc=Combo bẻ khóa Locket Gold an toàn: Giữ nguyên 100% bạn bè và chạy Sticker AI độc lập qua Cloudflare cá nhân.
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,://googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# Điều hướng duy nhất cổng vẽ ảnh Sticker AI về server Cloudflare cá nhân của bạn
^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage https://workers.dev 307

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-none-match

[Script]
# 1. Chiều Request xóa cache gây lỗi kết nối mạng
deleteHeader_RC = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://githubusercontent.com
deleteHeader_Firebase = type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://githubusercontent.com

# 2. Chiều Response bẻ khóa Gold & đồng bộ danh sách bạn bè an toàn (Lấy từ kho lưu trữ thô GitHub không sợ die)
revenuecat = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://githubusercontent.com
locket_rc = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://githubusercontent.com

# 3. Điều hướng xử lý vẽ ảnh AI qua file script photobooth.js lưu cục bộ trên máy tính của bạn
locket_pb_req = type=http-request,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage,script-path=photobooth.js,requires-body=true,max-size=-1,timeout=60

[Host]
://googleapis.com = 0.0.0.0

[MITM]
hostname = %APPEND% ://revenuecat.com, ://googleapis.com, ://locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, spring-sky-609d.dwcbaocuteee.workers.dev
